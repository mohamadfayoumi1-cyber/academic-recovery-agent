    {
      "parameters": {
        "jsCode": "/* Work out which sheet rows to erase for this course.\n\n   The Google Sheets node deletes by row number, so each matching record is\n   mapped back to its row: the Nth data row returned by a read of the whole\n   tab is sheet row N + 1, because row 1 is the header.\n\n   Assessment rows come back in DESCENDING order on purpose. Deleting a row\n   shifts every row below it up, so deleting bottom-up keeps the remaining\n   row numbers correct. */\n\nconst body = $('Webhook').first().json.body || {};\nconst course_id  = String(body.course_id || '').trim();\nconst student_id = String(body.student_id || '').trim();\n\nif (!course_id)  throw new Error('course_id is required.');\nif (!student_id) throw new Error('student_id is required.');\n\nconst courses = $('Read Courses').all().map(i => i.json);\nconst idx = courses.findIndex(\n  c => String(c.course_id).trim() === course_id &&\n       String(c.student_id).trim() === student_id\n);\n\n/* Refuse to touch anything unless the course belongs to this student. */\nif (idx === -1) throw new Error('That course was not found for this student.');\n\nconst courseRow = idx + 2;\n\nconst assessmentRows = $('Read Assessments').all()\n  .map((i, n) => ({ row: n + 2, json: i.json }))\n  .filter(r => String(r.json.course_id).trim() === course_id)\n  .map(r => r.row)\n  .sort((a, b) => b - a);\n\nreturn [{ json: {\n  course_id: course_id,\n  student_id: student_id,\n  course_name: (courses[idx] || {}).course_name || '',\n  courseRow: courseRow,\n  assessmentRows: assessmentRows,\n  deleted_assessments: assessmentRows.length,\n} }];\n"
      },
      "id": "aa11bb22-0007-4000-8000-000000000007",
      "name": "Plan Deletions",
      "type": "n8n-nodes-base.code",
