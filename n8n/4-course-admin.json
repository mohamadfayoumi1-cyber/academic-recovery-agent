      "id": "aa11bb22-0006-4000-8000-000000000006",
      "name": "Read Assessments",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        680,
        120
      ],
      "executeOnce": true,
