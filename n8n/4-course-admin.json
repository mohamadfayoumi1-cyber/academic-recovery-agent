    {
      "parameters": {
        "jsCode": "/* One item per assessment row, still descending. Returning [] simply ends\n   the branch, which is fine - the response has already been sent. */\nconst rows = $('Plan Deletions').first().json.assessmentRows || [];\nreturn rows.map(r => ({ json: { row: r } }));\n"
      },
