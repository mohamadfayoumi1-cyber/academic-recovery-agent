    {
      "parameters": {
        "jsCode": "const body = $('Webhook').first().json.body || {};\nconst rows = $input.all().map(i => i.json).filter(r => r && r.email);\n\nconst action = String(body.action || 'login');\nconst email  = String(body.email || '').trim().toLowerCase();\nconst hash   = String(body.password_hash || '');\n\nconst found = rows.find(r => String(r.email).trim().toLowerCase() === email);\nconst fail  = m => [{ json: { _new: 'no', response: { success: false, error: m } } }];\n\n/* ---------- LOGIN ---------- */\nif (action === 'login') {\n  if (!found) return fail('No account found for that email.');\n  if (String(found.password_hash) !== hash) return fail('Incorrect email or password.');\n\n  return [{ json: { _new: 'no', response: {\n    success: true,\n    student_id: found.student_id,\n    email: found.email,\n    full_name: found.name,\n    university: found.university,\n    major: found.major,\n    semester: found.semester,\n    weekly_study_hours: Number(found.weekly_study_hours) || 15,\n    target_gpa: found.target_gpa || null,\n  }}}];\n}\n\n/* ---------- SIGN UP ---------- */\nif (found) return fail('An account with this email already exists.');\n\n/* Next id = highest existing id + 1, NOT rows.length + 1.\n   Counting rows breaks the moment any row is deleted: 9 students, delete\n   S005, 8 rows remain, and the next signup is handed S009 - a duplicate of\n   a live account, silently merging two students' courses and grades. */\nconst highest = rows.reduce((max, r) => {\n  const n = parseInt(String(r.student_id || '').replace(/^S/i, ''), 10);\n  return Number.isFinite(n) && n > max ? n : max;\n}, 0);\nconst student_id = 'S' + String(highest + 1).padStart(3, '0');\nconst name = body.full_name || '';\n\nreturn [{ json: {\n  _new: 'yes',\n\n  student_id: student_id,\n  name: name,\n  email: email,\n  password_hash: hash,\n  university: body.university || '',\n  major: body.major || '',\n  semester: body.semester || '',\n  weekly_study_hours: Number(body.weekly_study_hours) || 15,\n  target_gpa: body.target_gpa || '',\n  created_at: new Date().toISOString(),\n\n  response: {\n    success: true,\n    student_id: student_id,\n    email: email,\n    full_name: name,\n    university: body.university || '',\n    major: body.major || '',\n    semester: body.semester || '',\n    weekly_study_hours: Number(body.weekly_study_hours) || 15,\n    target_gpa: body.target_gpa || '',\n  },\n}}];"
      },
