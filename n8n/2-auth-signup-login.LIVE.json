    {
      "parameters": {
        "jsCode": "const body = $('Webhook1').first().json.body || {};\nconst rows = $input.all().map(i => i.json).filter(r => r && r.email);\n\nconst action = String(body.action || 'login');\nconst email  = String(body.email || '').trim().toLowerCase();\nconst hash   = String(body.password_hash || '');\n\nconst found = rows.find(r => String(r.email).trim().toLowerCase() === email);\nconst fail  = m => [{ json: { _new: 'no', response: { success: false, error: m } } }];\n\n/* ---------- LOGIN ---------- */\nif (action === 'login') {\n  if (!found) return fail('No account found for that email.');\n  if (String(found.password_hash) !== hash) return fail('Incorrect email or password.');\n\n  return [{ json: { _new: 'no', response: {\n    success: true,\n    student_id: found.student_id,\n    email: found.email,\n    full_name: found.name,\n    university: found.university,\n    major: found.major,\n    semester: found.semester,\n    weekly_study_hours: Number(found.weekly_study_hours) || 15,\n    target_gpa: found.target_gpa || null,\n  }}}];\n}\n\n/* ---------- SIGN UP ---------- */\nif (found) return fail('An account with this email already exists.');\n\n/* The student types their own university student id on the sign up form.\n   It is the key that joins Students -> Courses -> Assessments -> StudyPlans,\n   so it has to be present and unique. */\nconst student_id = String(body.student_id || '').trim();\n\nif (!student_id) return fail('Please enter your student ID.');\n\nconst idTaken = rows.some(r => String(r.student_id || '').trim().toLowerCase() === student_id.toLowerCase());\nif (idTaken) return fail('An account with this student ID already exists.');\nconst name = body.full_name || '';\n\nreturn [{ json: {\n  _new: 'yes',\n\n  student_id: student_id,\n  name: name,\n  email: email,\n  password_hash: hash,\n  university: body.university || '',\n  major: body.major || '',\n  semester: body.semester || '',\n  weekly_study_hours: Number(body.weekly_study_hours) || 15,\n  target_gpa: body.target_gpa || '',\n  created_at: new Date().toISOString(),\n\n  response: {\n    success: true,\n    student_id: student_id,\n    email: email,\n    full_name: name,\n    university: body.university || '',\n    major: body.major || '',\n    semester: body.semester || '',\n    weekly_study_hours: Number(body.weekly_study_hours) || 15,\n    target_gpa: body.target_gpa || '',\n  },\n}}];"
      },
