      "parameters": {
        "jsCode": "const rows = $input.all()\n  .map(i => i.json)\n  .filter(r => r && Object.keys(r).length > 0);\n\nreturn [{ json: {\n  success: true,\n  message: 'n8n is connected and can read your Google Sheet.',\n  sheet: 'Students',\n  rows_found: rows.length,\n  columns_found: rows.length ? Object.keys(rows[0]) : [],\n  you_sent: $('Webhook').first().json.body,\n  time: new Date().toISOString(),\n}}];"
